{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CryptoPulseListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::REEMPLAZA-CON-TU-BUCKET"]
    },
    {
      "Sid": "CryptoPulseReadWriteObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::REEMPLAZA-CON-TU-BUCKET/*"]
    }
  ]
}
